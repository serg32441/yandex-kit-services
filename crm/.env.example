# Пароль базы данных PostgreSQL
POSTGRES_PASSWORD=your_strong_password_here

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IP сервера для webhook режима бота (рекомендуется)
WEBHOOK_HOST=your_server_ip

# ИИ-анализ заявок через OpenRouter (openrouter.ai)
# Ключ для скоринга/рекомендаций. Без него работает только базовый скоринг по правилам.
OPENROUTER_API_KEY=
# Модель OpenRouter (по умолчанию tencent/hy3-preview)
OPENROUTER_MODEL=tencent/hy3-preview
